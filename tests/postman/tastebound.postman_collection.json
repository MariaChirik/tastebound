    {
      "name": "3. Каталог і фільтр алергенів",
      "item": [
        {
          "name": "Каталог без фільтрів",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код відповіді 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"У каталозі є страви\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "    pm.expect(pm.response.json().length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/dishes"
          }
        },
        {
          "name": "Фільтр: без глютену",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код відповіді 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const dishes = pm.response.json();",
                  "pm.test(\"Немає страв з глютеном\", function () {",
                  "    dishes.forEach(function (dish) {",
                  "        pm.expect(dish.allergens).to.not.include(\"gluten\");",
                  "    });",
                  "});",
                  "const dish = dishes.find(function (d) { return d.orderable; });",
                  "pm.test(\"Є страва для замовлення\", function () {",
                  "    pm.expect(dish).to.be.an(\"object\");",
                  "});",
                  "pm.collectionVariables.set(\"dishId\", dish.id);",
                  "pm.collectionVariables.set(\"dishName\", dish.name);",
                  "pm.collectionVariables.set(\"dishPrice\", dish.price);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/dishes?exclude_allergens=gluten"
          }
        },
        {
          "name": "Фільтр: веганські страви без арахісу",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код відповіді 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Лише веганські страви без арахісу\", function () {",
                  "    pm.response.json().forEach(function (dish) {",
                  "        pm.expect(dish.diets).to.include(\"vegan\");",
                  "        pm.expect(dish.allergens).to.not.include(\"peanuts\");",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/catalog/dishes?diet=vegan&exclude_allergens=peanuts"
          }
        }
      ]

            "url": "{{baseUrl}}/api/orders/groups/{{groupCode}}/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\"address\": \"вул. Хрещатик, 22\", \"lat\": 50.4501, \"lng\": 30.5234, \"phone\": \"+380501234567\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A оформлює спільне замовлення",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код відповіді 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const order = pm.response.json();",
                  "const price = Number(pm.collectionVariables.get(\"dishPrice\"));",
                  "pm.test(\"Замовлення чекає оплати часток\", function () {",
                  "    pm.expect(order.status).to.eql(\"awaiting_payment\");",
                  "    pm.expect(order.participants.length).to.eql(2);",
                  "});",
                  "pm.test(\"Сума рахується за цінами каталогу\", function () {",
                  "    pm.expect(order.total).to.eql(Math.round(price * 3 * 100) / 100);",
                  "});",
                  "pm.test(\"Розраховано час доставки\", function () {",
                  "    pm.expect(order.eta_minutes).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set(\"groupOrderId\", order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/groups/{{groupCode}}/checkout",
            "body": {
              "mode": "raw",
              "raw": "{\"address\": \"вул. Хрещатик, 22\", \"lat\": 50.4501, \"lng\": 30.5234, \"phone\": \"+380501234567\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A оплачує свою частку карткою",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Код відповіді 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const order = pm.response.json().order;",
                  "pm.test(\"Частка A оплачена, замовлення чекає B\", function () {",
                  "    pm.expect(order.status).to.eql(\"awaiting_payment\");",
                  "    const mine = Object.values(order.shares).filter(function (s) {",
                  "        return s.status === \"paid\"; });",
                  "    pm.expect(mine.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenA}}"
              }
            ],
            "url": "{{baseUrl}}/api/orders/orders/{{groupOrderId}}/pay",
